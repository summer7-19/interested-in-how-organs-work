{
  "name": "@organ-workflow/server",
  "version": "0.1.0",
  "private": true,
  "description": "人体器官科普站点后端：仅提供科普数据与媒体元数据，不提供诊断/治疗/个体化建议",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
